# Azure Speech-to-Text Configuration
AZURE_SPEECH_KEY=your_azure_speech_key_here
AZURE_SPEECH_REGION=francecentral

# Azure Text Analytics Configuration (for summarization)
AZURE_LANGUAGE_KEY=your_azure_language_key_here
AZURE_LANGUAGE_ENDPOINT=https://your-resource.cognitiveservices.azure.com/

# Azure Translator Configuration
TRANSLATOR_KEY=your_translator_key_here
TRANSLATOR_REGION=francecentral

# Server Port (optional, default is 8000)
PORT=8000
